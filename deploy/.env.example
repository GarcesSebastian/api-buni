# ---------------------------------------------------------------------------
# Plantilla de entorno para el stack LOCAL de Buni (compose.dev.yml)
# ---------------------------------------------------------------------------
# Buni se levanta en local con `docker compose -f compose.dev.yml up --build`
# desde la carpeta api-buni. El compose ya trae valores por defecto para TODO,
# así que este archivo es opcional: cópialo a ../.env (junto al compose) solo si
# quieres personalizar credenciales. No hay reverse proxy, ni TLS, ni dominio:
# todo corre en localhost.
#
#   cp deploy/.env.example .env
#
# Todos los nombres existen literalmente en api-buni/src/config/env.ts

# ---------------------------------------------------------------------------
# Base de datos MySQL 8
# ---------------------------------------------------------------------------
# Contraseña de root de MySQL. El compose la usa tanto para el init como para la
# conexión de la API (DB_USER=root en local) y el healthcheck del contenedor.
DB_PASSWORD=buni
# Puerto de MySQL publicado en el host.
DB_PORT=3306
# DB_HOST (db), DB_USER (root) y DB_NAME (buni) los fija el compose; no hace
# falta tocarlos en local.

# ---------------------------------------------------------------------------
# API (api-buni/src/config/env.ts)
# ---------------------------------------------------------------------------
# Secreto JWT: 32+ caracteres y distinto de "your_secret_key".
JWT_SECRET=dev_jwt_secret_change_me_min_32_chars_0001
# Administrador en memoria que puede entrar sin estar en la base de datos.
ADMIN_NAME=admin
ADMIN_EMAIL=admin@buni.local
ADMIN_PASSWORD=admin1234
# ADMIN_ROLE lo fija el compose (admin).
# Envío de correo (el esquema exige las SMTP_* no vacías). Los valores por
# defecto apuntan a un Mailpit opcional; sirven para arrancar sin enviar correo.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=dev
SMTP_PASS=dev