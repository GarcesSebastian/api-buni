exports[`POST /auth/login > (a) admin creds -> 200 admin user shape (additive isAdmin + token_hs cookie) 1`] = `
{
  "body": {
    "token": "<token>",
    "user": {
      "email": "admin@buni.test",
      "isAdmin": true,
      "name": "Administrador",
      "permissions": "***",
      "role": "admin",
    },
  },
  "status": 200,
}
`;

exports[`POST /auth/login > (b) valid normal user -> 200 normal user shape 1`] = `
{
  "body": {
    "token": "<token>",
    "user": {
      "email": "normal@buni.test",
      "id": "user-0000-0000-0000-000000000001",
      "isAdmin": false,
      "name": "Usuario Normal",
      "permissions": {
        "events": {
          "create": true,
          "delete": false,
          "edit": false,
          "view": true,
