exports[`events permission chain (verifyToken runs first) > (a) no Authorization header -> 401 Token no proporcionado 1`] = `
{
  "body": {
    "error": "Token no proporcionado",
  },
  "status": 401,
}
`;

exports[`events permission chain (verifyToken runs first) > (b) invalid token -> 401 Token inválido 1`] = `
{
  "body": {
    "error": "Token inválido",
  },
  "status": 401,
}
`;

exports[`events permission chain (verifyToken runs first) > (c) valid token lacking events.create (PUT -> edit denied) -> 401 message 1`] = `
{
  "body": {
    "error": "No tienes permisos para actualizar eventos",
  },
  "status": 401,
}
`;

exports[`events permission chain (verifyToken runs first) > (d) valid token whose role row is missing (deleted role) -> 401 (approved change ii) 1`] = `
{
  "body": {
    "error": "No tienes permisos para crear eventos",
  },
  "status": 401,
}
`;

exports[`events permission chain (verifyToken runs first) > (e) admin token -> reaches controller (201) 1`] = `201`;

exports[`events permission chain (verifyToken runs first) > DELETE denied message for custom role 1`] = `
{
  "body": {
    "error": "No tienes permisos para eliminar eventos",
  },
  "status": 401,
}
`;
